# Copy to .env.local and fill in. Never commit secrets.

# mock | zoho — production must not use mock
CRM_MODE=mock

# LLM (first configured wins: Groq → OpenRouter → Gemini)
GROQ_API_KEY=

# OpenRouter free tier: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional; default meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=
# Optional ranking headers on OpenRouter
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_APP_NAME=Mahindra AI Agent

# Fallback when higher-priority providers fail
GOOGLE_GENERATIVE_AI_API_KEY=

# Signed session cookie (use a long random string)
SESSION_SECRET=replace-with-a-long-random-secret

# Account store. Example: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=mahindra

# Zoho CRM (only when CRM_MODE=zoho)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# e.g. https://www.zohoapis.in or https://www.zohoapis.com
ZOHO_API_DOMAIN=https://www.zohoapis.in
# Accounts domain for OAuth token refresh, e.g. https://accounts.zoho.in
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
# Custom field API name for vehicle model on Leads
ZOHO_VEHICLE_FIELD=Vehicle_Model

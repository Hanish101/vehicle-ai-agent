# Copy to .env.local and fill in. Never commit secrets.

# mock | zoho — production must not use mock
CRM_MODE=mock

# Primary LLM (Groq)
GROQ_API_KEY=

# Secondary LLM — fallback when Groq fails (Gemini via @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=

# Signed session cookie (use a long random string)
SESSION_SECRET=replace-with-a-long-random-secret

# Zoho CRM (only when CRM_MODE=zoho)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# e.g. https://www.zohoapis.in or https://www.zohoapis.com
ZOHO_API_DOMAIN=https://www.zohoapis.in
# Accounts domain for OAuth token refresh, e.g. https://accounts.zoho.in
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
# Custom field API name for vehicle model on Leads
ZOHO_VEHICLE_FIELD=Vehicle_Model
